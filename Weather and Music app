/* =========================
   HELPERS
========================= */

function splitIntoSentences(text) {
  const cleaned = cleanArticleText(text)
    .replace(/([a-z])\.\s+([a-z])/g, "$1 $2");

  const matches = cleaned.match(/[^.!?]+[.!?]+/g);
  return matches ? matches.map(s => s.trim()).filter(Boolean) : [];
}

function cleanHeadline(title) {
  return cleanArticleText(title).replace(/^(watch|video)\s*:\s*/i, "").trim();
}

function isNearDuplicateSentence(sentence, existing) {
  const a = normalizeForCompare(sentence);
  return existing.some(s => overlapScore(a, normalizeForCompare(s)) > 0.78);
}

function normalizeForCompare(s) {
  return cleanArticleText(s).toLowerCase().replace(/[^a-z0-9\s]/g, " ").replace(/\s+/g, " ").trim();
}

function overlapScore(a, b) {
  const setA = new Set(a.split(" ").filter(Boolean));
  const setB = new Set(b.split(" ").filter(Boolean));
  if (!setA.size || !setB.size) return 0;

  let overlap = 0;
  setA.forEach(word => {
    if (setB.has(word)) overlap++;
  });

  return overlap / Math.max(setA.size, setB.size);
}

function stripHtml(html) {
  return decodeHtml(
    String(html)
      .replace(/<br\s*\/?>/gi, " ")
      .replace(/<\/p>/gi, " ")
      .replace(/<[^>]+>/g, " ")
  );
}

function cleanArticleText(s) {
  return decodeHtml(String(s || ""))
    .replace(/#x27;|#39;|#27;/gi, "'")
    .replace(/#x2019;|#8217;/gi, "'")
    .replace(/\u00A0/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function cleanText(s) {
  return cleanArticleText(s);
}

function decodeHtml(str) {
  let out = String(str || "");

  for (let i = 0; i < 3; i++) {
    const prev = out;

    out = out
      .replace(/&nbsp;/gi, " ")
      .replace(/&amp;/gi, "&")
      .replace(/&quot;/gi, "\"")
      .replace(/&#39;|&apos;/gi, "'")
      .replace(/&lt;/gi, "<")
      .replace(/&gt;/gi, ">")
      .replace(/&#x([0-9a-f]+);/gi, (_, hex) => safeFromCodePoint(parseInt(hex, 16)))
      .replace(/&#([0-9]+);/g, (_, dec) => safeFromCodePoint(parseInt(dec, 10)));

    if (out === prev) break;
  }

  return out;
}

function safeFromCodePoint(code) {
  try {
    return Number.isFinite(code) ? String.fromCodePoint(code) : "";
  } catch (e) {
    return "";
  }
}

function escapeHtml(str) {
  return String(str || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function escapeAttribute(str) {
  return escapeHtml(str).replace(/"/g, "&quot;");
}

function escapeRegex(str) {
  return String(str).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}
