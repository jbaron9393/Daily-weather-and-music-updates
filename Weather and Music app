function getDenverConcerts(headers, tz) {
  const sourceUrl = "https://seatgeek.com/cities/denver/concerts";
  const clientId = PropertiesService.getScriptProperties().getProperty("SEATGEEK_CLIENT_ID");

  try {
    const now = new Date();
    const weekEnd = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
    const monthEnd = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    const events = clientId
      ? fetchSeatGeekApiConcerts(clientId, headers, now, monthEnd, sourceUrl)
      : fetchSeatGeekPublicConcerts(headers, sourceUrl);
    const upcoming = events.filter(event =>
      event.date &&
      event.date >= now &&
      event.date <= monthEnd &&
      isTrackedDenverConcertVenue(event.venue)
    );

    const thisWeek = upcoming
      .filter(event => event.date <= weekEnd)
      .sort((a, b) => a.date - b.date);

    // SeatGeek's event score is its popularity signal. Display order is used only
    // as a stable tie-breaker, then the selected highlights are shown by date.
    const monthHighlights = upcoming
      .slice()
      .sort((a, b) => (b.score - a.score) || (a.pageOrder - b.pageOrder))
      .slice(0, 10)
      .sort((a, b) => a.date - b.date);

    thisWeek.forEach(event => event.when = formatConcertDate(event.date, tz, event.dateOnly));
    monthHighlights.forEach(event => event.when = formatConcertDate(event.date, tz, event.dateOnly));

    return { thisWeek, monthHighlights, sourceUrl };
  } catch (e) {
    Logger.log(`Error fetching Denver concerts from SeatGeek: ${e}`);
    return { thisWeek: [], monthHighlights: [], sourceUrl };
  }
}

function fetchSeatGeekApiConcerts(clientId, headers, now, monthEnd, sourceUrl) {
  const params = {
    client_id: clientId,
    "venue.city": "Denver",
    "venue.state": "CO",
    "taxonomies.name": "concert",
    "datetime_utc.gte": now.toISOString().replace(/\.\d{3}Z$/, "Z"),
    "datetime_utc.lte": monthEnd.toISOString().replace(/\.\d{3}Z$/, "Z"),
    per_page: 100,
    sort: "datetime_utc.asc"
  };
  const apiUrl = "https://api.seatgeek.com/2/events?" + Object.keys(params)
    .map(key => `${encodeURIComponent(key)}=${encodeURIComponent(params[key])}`)
    .join("&");
  const resp = UrlFetchApp.fetch(apiUrl, {
    method: "get",
    headers: Object.assign({}, headers, { Accept: "application/json" }),
    muteHttpExceptions: true,
    followRedirects: true
  });

  if (resp.getResponseCode() < 200 || resp.getResponseCode() >= 300) {
    throw new Error(`SeatGeek API returned ${resp.getResponseCode()}: ${resp.getContentText().slice(0, 300)}`);
  }

  return extractSeatGeekApiConcerts(JSON.parse(resp.getContentText()), sourceUrl);
}

function fetchSeatGeekPublicConcerts(headers, sourceUrl) {
  // SeatGeek blocks requests from Google Apps Script with a 403. Jina Reader
  // renders those public SeatGeek pages as text, so no API account is needed.
  const requests = [{
    url: "https://r.jina.ai/https://seatgeek.com/cities/denver/concerts",
    method: "get",
    headers: Object.assign({}, headers, { Accept: "text/plain" }),
    muteHttpExceptions: true,
    followRedirects: true
  }];
  // SeatGeek's city page is lazy-loaded and can omit cards even when page=N is
  // requested. Double-check every requested venue's own calendar so those shows
  // are not lost just because they were outside the city page's initial batch.
  getTrackedDenverConcertVenues().forEach(venue => {
    requests.push({
      url: `https://r.jina.ai/https://seatgeek.com/venues/${venue.slug}/tickets`,
      method: "get",
      headers: Object.assign({}, headers, { Accept: "text/plain" }),
      muteHttpExceptions: true,
      followRedirects: true
    });
  });
  const responses = UrlFetchApp.fetchAll(requests);
  let events = [];

  responses.forEach((resp, index) => {
    if (resp.getResponseCode() < 200 || resp.getResponseCode() >= 300) {
      Logger.log(`SeatGeek reader request ${index + 1} returned ${resp.getResponseCode()}`);
      return;
    }
    events = events.concat(extractSeatGeekReaderConcerts(resp.getContentText(), sourceUrl));
  });

  const seen = new Set();
  events = events.filter(event => {
    const key = `${normalizeTitleKey(event.title)}|${event.date.toISOString()}|${normalizeUrlKey(event.link)}`;
    if (seen.has(key)) return false;
    seen.add(key);
    event.pageOrder = seen.size - 1;
    return true;
  });

  if (!events.length) {
    throw new Error("SeatGeek reader did not return any Denver concerts");
  }

  Logger.log(`Found ${events.length} unique Denver concerts after checking the city listing and all 18 venue calendars.`);
  return events;
}

function extractSeatGeekReaderConcerts(text, sourceUrl) {
  const events = [];
  const seen = new Set();
  // The Denver SeatGeek page includes the full metro area. Do not require
  // "/denver" in the event URL: Red Rocks uses Morrison, Fiddler's Green uses
  // Englewood, and other listed shows use Boulder, Golden, and nearby cities.
  const linkRe = /\[([^\]]+)\]\((https?:\/\/(?:www\.)?seatgeek\.com\/[^)]+-tickets\/[^)]*20\d{2}-\d{2}-\d{2}[^)]*)\)/gi;
  let match;

  while ((match = linkRe.exec(String(text || ""))) !== null) {
    const link = match[2].replace(/\\([?&])/g, "$1");
    const title = extractSeatGeekBandName(match[1], link);
    const venue = findTrackedDenverConcertVenue(`${match[1]} ${link}`);
    const dateMatch = link.match(/\b(20\d{2}-\d{2}-\d{2})\b/);
    if (!dateMatch) continue;
    const timeMatch = link.match(/20\d{2}-\d{2}-\d{2}-(\d{1,2})(?:-(\d{2}))?-(am|pm)\b/i);
    let hour = timeMatch ? Number(timeMatch[1]) % 12 : 23;
    const minute = timeMatch && timeMatch[2] ? Number(timeMatch[2]) : (timeMatch ? 0 : 59);
    if (timeMatch && timeMatch[3].toLowerCase() === "pm") hour += 12;
    const date = new Date(`${dateMatch[1]}T${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}:00-06:00`);
    const key = `${normalizeTitleKey(title)}|${dateMatch[1]}`;
    if (!title || !venue || isNaN(date.getTime()) || seen.has(key)) continue;

    seen.add(key);
    events.push({ title, venue, date, dateOnly: !timeMatch, link: link || sourceUrl, score: 0, pageOrder: events.length });
  }

  return events;
}

function extractSeatGeekBandName(anchorText, eventUrl) {
  const text = cleanText(String(anchorText || "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/^\(opens in new tab\)\s*/i, ""));
  const ticketText = text.match(/Find tickets to (.+?) on (?:Mon|Tue|Wed|Thu|Fri|Sat|Sun),?\s/i);
  if (ticketText && ticketText[1]) return cleanText(ticketText[1]);

  // The rendered link text can contain the entire event card. SeatGeek's event
  // URL starts with the performer slug, which is a safer fallback than showing it.
  const slugMatch = String(eventUrl || "").match(/seatgeek\.com\/([^/?]+)-tickets\//i);
  if (slugMatch && slugMatch[1]) {
    return slugMatch[1]
      .split("-")
      .map(word => word ? word.charAt(0).toUpperCase() + word.slice(1) : "")
      .join(" ");
  }

  return text;
}

function extractSeatGeekApiConcerts(payload, sourceUrl) {
  const events = payload && Array.isArray(payload.events) ? payload.events : [];

  return events.map((event, index) => {
    const performers = Array.isArray(event.performers)
      ? event.performers.map(performer => performer && (performer.short_name || performer.name)).filter(Boolean)
      : [];
    const dateValue = event.datetime_utc || event.datetime_local || "";
    const date = new Date(dateValue);

    const venue = findTrackedDenverConcertVenue(event.venue && event.venue.name ? event.venue.name : "");

    return {
      title: cleanText(performers.join(" & ") || event.short_title || event.title || ""),
      venue,
      date: isNaN(date.getTime()) ? null : date,
      link: event.url || sourceUrl,
      score: Number(event.score || 0) || 0,
      pageOrder: index
    };
  }).filter(event => event.title && event.date && event.venue);
}

function findTrackedDenverConcertVenue(value) {
  const normalized = cleanText(value || "")
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
  const venues = getTrackedDenverConcertVenues();

  for (let i = 0; i < venues.length; i++) {
    if (venues[i].aliases.some(alias => (` ${normalized} `).indexOf(` ${alias} `) >= 0)) {
      return venues[i].name;
    }
  }
  return "";
}

