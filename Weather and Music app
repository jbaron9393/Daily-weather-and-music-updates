/* =========================
   SECTION SCRAPING
========================= */

function getSectionArticles(url, categoryLabel, headers, maxItems) {
  try {
    const resp = UrlFetchApp.fetch(url, {
      method: "get",
      headers,
      muteHttpExceptions: true,
      followRedirects: true
    });

    if (resp.getResponseCode() < 200 || resp.getResponseCode() >= 300) {
      Logger.log(`Failed section fetch: ${url}`);
      return [];
    }

    const html = resp.getContentText();
    let items = [];

    // First try JSON-LD Article extraction
    items = items.concat(extractArticlesFromJsonLd(html, url, categoryLabel));

    // Then try anchor/title scraping
    items = items.concat(extractArticlesFromAnchors(html, url, categoryLabel));

    // De-duplicate and filter hard
    const deduped = dedupeArticles(items)
      .filter(isLikelyRealArticleFromFeed)
      .slice(0, maxItems);

    return deduped;
  } catch (e) {
    Logger.log(`Error fetching section ${url}: ${e}`);
    return [];
  }
}

function extractArticlesFromJsonLd(html, baseUrl, categoryLabel) {
  const out = [];
  const scripts = html.match(/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi) || [];

  for (let i = 0; i < scripts.length; i++) {
    const raw = scripts[i].replace(/<\/?script[^>]*>/gi, "").trim();
    try {
      const parsed = JSON.parse(raw);
      collectJsonLdArticles(parsed, out, baseUrl, categoryLabel);
    } catch (e) {
      // ignore malformed json-ld
    }
  }

  return out;
}

function collectJsonLdArticles(node, out, baseUrl, categoryLabel) {
  if (!node) return;

  if (Array.isArray(node)) {
    node.forEach(n => collectJsonLdArticles(n, out, baseUrl, categoryLabel));
    return;
  }

  if (typeof node !== "object") return;

  const type = Array.isArray(node["@type"]) ? node["@type"].join(" ") : String(node["@type"] || "");
  const isArticleish = /Article|NewsArticle|ReportageNewsArticle/i.test(type);

  if (isArticleish) {
    const title = cleanHeadline(cleanText(node.headline || node.name || ""));
    const link = absolutizeUrl(node.url || "", baseUrl);
    const description = cleanText(node.description || "");

    if (title && link) {
      out.push({
        title,
        link,
        description,
        category: categoryLabel
      });
    }
  }

  Object.keys(node).forEach(key => collectJsonLdArticles(node[key], out, baseUrl, categoryLabel));
}

function extractArticlesFromAnchors(html, baseUrl, categoryLabel) {
  const out = [];
  const anchorRe = /<a\b[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  let match;

  while ((match = anchorRe.exec(html)) !== null) {
    const href = absolutizeUrl(match[1], baseUrl);
    const text = cleanHeadline(cleanArticleText(stripHtml(match[2])));

    if (!href || !text) continue;
    if (!looksLikeAbcArticleUrl(href)) continue;
    if (text.length < 25) continue;
    if (isLikelyNonArticleTitle(text, href)) continue;

    out.push({
      title: text,
      link: href,
      description: "",
      category: categoryLabel
    });

    if (out.length >= 40) break;
  }

  return out;
}

function looksLikeAbcArticleUrl(url) {
  const u = String(url || "").toLowerCase();

  if (!/abcnews\.go\.com|abcnews\.com/.test(u)) return false;
  if (/\/video\//.test(u)) return false;
  if (/\/live\//.test(u)) return false;
  if (/\/photos\//.test(u)) return false;
  if (/\/gallery\//.test(u)) return false;
  if (/\/slideshow\//.test(u)) return false;
  if (/\/playlist\//.test(u)) return false;
  if (/\/shop\//.test(u)) return false;
  if (/\/author\//.test(u)) return false;
  if (/\/tag\//.test(u)) return false;

  // Many ABC article links use story?id=
  if (/story\?id=/.test(u)) return true;

  // Also allow article-like paths on abcnews.com
  if (/abcnews\.com\/[a-z0-9\-\/]+/.test(u)) return true;

  return false;
}

function isLikelyNonArticleTitle(title, href) {
  const t = String(title || "").toLowerCase();
  const u = String(href || "").toLowerCase();

  return (
    /\b(video|watch live|playlist|photos|gallery|slideshow|shop|listen)\b/.test(t) ||
    /\/video\//.test(u) ||
    /\/live\//.test(u) ||
    /\/photos\//.test(u) ||
    /\/gallery\//.test(u) ||
    /\/slideshow\//.test(u)
  );
}

function dedupeArticles(items) {
  const seen = new Set();
  const out = [];

  items.forEach(item => {
    const key = normalizeUrlKey(item.link) || normalizeTitleKey(item.title);
    if (!key || seen.has(key)) return;
    seen.add(key);
    out.push(item);
  });

  return out;
}

function normalizeUrlKey(url) {
  if (!url) return "";
  return String(url)
    .toLowerCase()
    .replace(/^https?:\/\//, "")
    .replace(/[?#].*$/, "")
    .replace(/\/+$/, "")
    .trim();
}

function normalizeTitleKey(title) {
  return cleanArticleText(title || "").toLowerCase().replace(/[^a-z0-9\s]/g, "").trim();
}

function absolutizeUrl(url, baseUrl) {
  if (!url) return "";
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith("//")) return "https:" + url;
  if (url.startsWith("/")) {
    const root = getRootUrl(baseUrl);
    return root + url;
  }
  return getRootUrl(baseUrl) + "/" + url.replace(/^\/+/, "");
}

function getRootUrl(url) {
  const m = String(url).match(/^(https?:\/\/[^\/]+)/i);
  return m ? m[1] : "https://abcnews.go.com";
}

function takeFromPool(chosen, seen, pool, count) {
  for (let i = 0; i < pool.length && count > 0; i++) {
    const item = pool[i];
    const key = normalizeUrlKey(item.link);
    if (!key || seen.has(key)) continue;
    seen.add(key);
    chosen.push(item);
    count--;
  }
}

function fillRoundRobin(chosen, seen, pools, targetTotal) {
  const indices = new Array(pools.length).fill(0);
  let progress = true;

  while (chosen.length < targetTotal && progress) {
    progress = false;

    for (let p = 0; p < pools.length; p++) {
      while (indices[p] < pools[p].length) {
        const item = pools[p][indices[p]++];
        const key = normalizeUrlKey(item.link);
        if (!key || seen.has(key)) continue;
        seen.add(key);
        chosen.push(item);
        progress = true;
        break;
      }

      if (chosen.length >= targetTotal) break;
    }
  }
}

