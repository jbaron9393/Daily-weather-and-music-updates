function getWeatherSummary(lat, lon, headers) {
  const TZ = "America/Denver";

  const pointUrl = `https://api.weather.gov/points/${lat},${lon}`;
  const pointJson = fetchJson(pointUrl, headers) || {};
  const props = pointJson.properties || {};

  const forecastUrl = props.forecast;
  const forecastHourlyUrl = props.forecastHourly;
  const stationsUrl = props.observationStations;

  const relativeLocation = props.relativeLocation && props.relativeLocation.properties
    ? props.relativeLocation.properties
    : {};
  const city = relativeLocation.city || "Glendale/Aurora";
  const state = relativeLocation.state || "CO";
  const location = `${city}, ${state}`;

  let current = "Unavailable";
  let updated = "";
  let wind = "Unavailable";

  if (stationsUrl) {
    const stationsJson = fetchJson(stationsUrl, headers) || {};
    const firstStation = stationsJson.observationStations && stationsJson.observationStations[0];

    if (firstStation) {
      const obsJson = fetchJson(`${firstStation}/observations/latest`, headers) || {};
      const o = obsJson.properties || {};

      const tempC = o.temperature && o.temperature.value;
      const tempF = tempC !== null && tempC !== undefined ? Math.round((tempC * 9) / 5 + 32) : null;

      const desc = o.textDescription || "Current conditions";
      current = `${desc}${tempF !== null ? `, ${tempF}°F` : ""}`;

      const windMs = o.windSpeed && o.windSpeed.value;
      const windMph = windMs !== null && windMs !== undefined ? Math.round(windMs * 2.23694) : null;
      const windDeg = o.windDirection && o.windDirection.value;
      const windDir = windDeg !== null && windDeg !== undefined ? degreesToCardinal(windDeg) : "";

      if (windMph !== null) {
        wind = `${windMph} mph${windDir ? ` ${windDir}` : ""}`;
      }

      if (o.timestamp) {
        updated = Utilities.formatDate(new Date(o.timestamp), TZ, "MMM d, yyyy h:mm a z");
      }
    }
  }

  let high = "Unavailable";
  let low = "Unavailable";
  let precipChance = "Unavailable";

  if (forecastUrl) {
    const dailyJson = fetchJson(forecastUrl, headers) || {};
    const periods = dailyJson.properties && dailyJson.properties.periods ? dailyJson.properties.periods : [];

    const todayKey = Utilities.formatDate(new Date(), TZ, "yyyy-MM-dd");
    const dayPeriod = periods.find(p =>
      p.isDaytime &&
      Utilities.formatDate(new Date(p.startTime), TZ, "yyyy-MM-dd") === todayKey
    ) || periods.find(p => p.isDaytime);

    const nightPeriod = periods.find(p => {
      if (p.isDaytime) return false;
      const d = new Date(p.startTime);
      return d > new Date();
    }) || periods.find(p => !p.isDaytime);

    if (dayPeriod && dayPeriod.temperature !== undefined) {
      high = `${dayPeriod.temperature}°${dayPeriod.temperatureUnit || "F"}`;
      const pop = dayPeriod.probabilityOfPrecipitation && dayPeriod.probabilityOfPrecipitation.value;
      if (pop !== null && pop !== undefined) precipChance = `${Math.round(pop)}%`;
    }

    if (nightPeriod && nightPeriod.temperature !== undefined) {
      low = `${nightPeriod.temperature}°${nightPeriod.temperatureUnit || "F"}`;
    }
  }

  let forecast3pm = "Unavailable";
  if (forecastHourlyUrl) {
    const hourlyJson = fetchJson(forecastHourlyUrl, headers) || {};
    const periods = hourlyJson.properties && hourlyJson.properties.periods ? hourlyJson.properties.periods : [];
    const at3pm = findBest3PmPeriod(periods, TZ);

    if (at3pm) {
      const temp = at3pm.temperature !== undefined ? `${at3pm.temperature}°${at3pm.temperatureUnit || "F"}` : "";
      const cond = at3pm.shortForecast || "Forecast";
      const pop = at3pm.probabilityOfPrecipitation && at3pm.probabilityOfPrecipitation.value;
      const popText = pop !== null && pop !== undefined ? `, precip ${Math.round(pop)}%` : "";
      forecast3pm = `${cond}${temp ? `, ${temp}` : ""}${popText}`;
    }
  }

  const sun = getSunriseSunset(lat, lon, TZ);
  const sunrise = sun.sunrise;
  const sunset = sun.sunset;

  const summary =
    `Now: ${current}. ` +
    `3:00 PM: ${forecast3pm}. ` +
    `High/Low: ${high}/${low}. ` +
    `Wind: ${wind}. ` +
    `Precipitation chance: ${precipChance}. ` +
    `Sunrise ${sunrise}, Sunset ${sunset}.`;

  return {
    location,
    current,
    forecast3pm,
    high,
    low,
    wind,
    precipChance,
    sunrise,
    sunset,
    updated,
    summary
  };
}

function fetchJson(url, headers) {
  try {
    const resp = UrlFetchApp.fetch(url, {
      method: "get",
      headers: headers || {},
      muteHttpExceptions: true,
      followRedirects: true
    });
    const code = resp.getResponseCode();
    if (code < 200 || code >= 300) return null;
    return JSON.parse(resp.getContentText());
  } catch (e) {
    return null;
  }
}

function findBest3PmPeriod(periods, tz) {
  if (!periods || !periods.length) return null;

  const now = new Date();
  const todayKey = Utilities.formatDate(now, tz, "yyyy-MM-dd");

  const today3 = periods.find(p => {
    const d = new Date(p.startTime);
    const hour = Number(Utilities.formatDate(d, tz, "H"));
    const key = Utilities.formatDate(d, tz, "yyyy-MM-dd");
    return key === todayKey && hour === 15 && d >= now;
  });
  if (today3) return today3;

  const next3 = periods.find(p => {
    const d = new Date(p.startTime);
    const hour = Number(Utilities.formatDate(d, tz, "H"));
    return d > now && hour === 15;
  });
  if (next3) return next3;

  return periods[0];
}

function getSunriseSunset(lat, lon, tz) {
  const url = `https://api.sunrise-sunset.org/json?lat=${lat}&lng=${lon}&formatted=0`;
  const json = fetchJson(url, {});
  if (!json || json.status !== "OK" || !json.results) {
    return { sunrise: "Unavailable", sunset: "Unavailable" };
  }

  return {
    sunrise: Utilities.formatDate(new Date(json.results.sunrise), tz, "h:mm a"),
    sunset: Utilities.formatDate(new Date(json.results.sunset), tz, "h:mm a")
  };
}

function degreesToCardinal(deg) {
  const dirs = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"];
  const normalized = (((deg % 360) + 360) % 360);
  const index = Math.round(normalized / 45) % 8;
  return dirs[index];
}

/* =========================
   ARTICLE ENRICHMENT
========================= */

function enrichArticles(items, headers, desiredCount) {
  const requests = items.map(item => ({
    url: item.link,
    method: "get",
    headers,
    muteHttpExceptions: true,
    followRedirects: true
  }));

  const responses = UrlFetchApp.fetchAll(requests);

  const enriched = items
    .map((item, i) => {
      try {
        const resp = responses[i];
        const code = resp.getResponseCode();
        if (code < 200 || code >= 300) return null;

        const html = resp.getContentText();
        if (!html || isClearlyNonArticlePage(item, html)) return null;

        const imageUrl =
          extractMetaTag(html, "property", "og:image") ||
          extractMetaTag(html, "name", "twitter:image") ||
          "";

        const metaDescription =
          extractMetaTag(html, "property", "og:description") ||
          extractMetaTag(html, "name", "description") ||
          item.description ||
          "";

        const paragraphText = extractVisibleParagraphs(html);
        const jsonLdBody = extractJsonLdArticleText(html);
        const articleText = jsonLdBody || paragraphText || metaDescription || item.description || "";

        if (!hasEnoughArticleText(paragraphText, jsonLdBody, metaDescription)) return null;

        const summary = buildSummary(articleText, metaDescription, item.title);
        if (!summary || summary === "Summary unavailable for this article.") return null;

        return {
          ...item,
          imageUrl,
          description: metaDescription,
          summary
        };
      } catch (err) {
        return null;
      }
    })
    .filter(Boolean);

  return desiredCount ? enriched.slice(0, desiredCount) : enriched;
}

function isLikelyRealArticleFromFeed(item) {
  const title = String(item.title || "").toLowerCase();
  const link = String(item.link || "").toLowerCase();
  const desc = String(item.description || "").toLowerCase();
  const combined = `${title} ${link} ${desc}`;

  if (!link) return false;

  if (
    /\b(video|watch live|live updates|livestream|playlist|photos|gallery|slideshow|shop|listen)\b/.test(combined) ||
    /\/video\//.test(link) ||
    /\/live\//.test(link) ||
    /\/photos\//.test(link) ||
    /\/gallery\//.test(link) ||
    /\/slideshow\//.test(link)
  ) {
    return false;
  }

  if (
    /story\?id=/.test(link) ||
    /abcnews\.go\.com\/[^\/]+\/[^\/]+/.test(link) ||
    /abcnews\.com\/[^\/]+\/[^\/]+/.test(link)
  ) {
    return true;
  }

  return !/\b(video|watch|playlist|photos|gallery)\b/.test(title);
}

function isClearlyNonArticlePage(item, html) {
  const title = String(item.title || "");
  const text = cleanArticleText(stripHtml(String(html || "").slice(0, 25000))).toLowerCase();
  const url = String(item.link || "").toLowerCase();

  if (
    /from here you can either hit the "back" button/.test(text) ||
    /visit the abcnews\.com home page/.test(text) ||
    /search for something on our site/.test(text) ||
    /\b404\b/.test(text) ||
    /page not found/.test(text)
  ) {
    return true;
  }

  if (
    /\/video\//.test(url) ||
    /\/live\//.test(url) ||
    /\/photos\//.test(url) ||
    /\/gallery\//.test(url) ||
    /\/slideshow\//.test(url)
  ) {
    return true;
  }

  if (/\b(video|watch live|playlist|slideshow|gallery|photos)\b/i.test(title)) {
    return true;
  }

  const paragraphs = getUsableParagraphsFromHtml(html);
  if (paragraphs.length < 2) return true;

  const joined = paragraphs.join(" ");
  const wordCount = joined.split(/\s+/).filter(Boolean).length;
  if (wordCount < 140) return true;

  return false;
}

function getUsableParagraphsFromHtml(html) {
  let text = String(html || "");
  text = text.replace(/<script[\s\S]*?<\/script>/gi, " ");
  text = text.replace(/<style[\s\S]*?<\/style>/gi, " ");

  const paragraphs = [];
  const re = /<p\b[^>]*>([\s\S]*?)<\/p>/gi;
  let match;

  while ((match = re.exec(text)) !== null) {
    const cleaned = cleanArticleText(stripHtml(match[1]));
    if (
      cleaned &&
      cleaned.length > 80 &&
      !/cookie|advertis|newsletter|sign up|terms|privacy|accept all|continue reading|video|watch on/i.test(cleaned)
    ) {
      paragraphs.push(cleaned);
    }
    if (paragraphs.length >= 12) break;
  }

  return paragraphs;
}

function hasEnoughArticleText(paragraphText, jsonLdBody, metaDescription) {
  const paraWords = String(paragraphText || "").split(/\s+/).filter(Boolean).length;
  const jsonWords = String(jsonLdBody || "").split(/\s+/).filter(Boolean).length;
  const metaWords = String(metaDescription || "").split(/\s+/).filter(Boolean).length;

  if (jsonWords >= 120) return true;
  if (paraWords >= 140) return true;
  if (paraWords < 80 && jsonWords < 80 && metaWords < 18) return false;

  return false;
}

function extractMetaTag(html, attrName, attrValue) {
  const re = new RegExp(
    `<meta[^>]*${attrName}=["']${escapeRegex(attrValue)}["'][^>]*content=["']([^"']+)["'][^>]*>`,
    "i"
  );
  const match = html.match(re);
  return match ? decodeHtml(match[1]).trim() : "";
}

function extractJsonLdArticleText(html) {
  const matches = html.match(/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi);
  if (!matches) return "";

  for (let i = 0; i < matches.length; i++) {
    const block = matches[i].replace(/<\/?script[^>]*>/gi, "").trim();
    try {
      const parsed = JSON.parse(block);
      const found = findArticleBodyInJson(parsed);
      if (found) return cleanArticleText(found);
    } catch (e) {
      // ignore invalid json-ld
    }
  }

  return "";
}

function findArticleBodyInJson(obj) {
  if (!obj) return "";

  if (Array.isArray(obj)) {
    for (let i = 0; i < obj.length; i++) {
      const found = findArticleBodyInJson(obj[i]);
      if (found) return found;
    }
    return "";
  }

  if (typeof obj === "object") {
    if (obj.articleBody && typeof obj.articleBody === "string") return obj.articleBody;
    for (const key in obj) {
      const found = findArticleBodyInJson(obj[key]);
      if (found) return found;
    }
  }

  return "";
}

function extractVisibleParagraphs(html) {
  return getUsableParagraphsFromHtml(html).join(" ");
}

/* =========================
   SUMMARY
========================= */

function buildSummary(articleText, description, title) {
  const cleanTitle = cleanHeadline(cleanArticleText(title || ""));
  let source = cleanArticleText(`${articleText || ""} ${description || ""}`);

  if (cleanTitle) {
    source = source.replace(new RegExp(escapeRegex(cleanTitle), "gi"), " ");
  }

  source = source
    .replace(/\bwatch:\s*/gi, "")
    .replace(/\bvideo:\s*/gi, "")
    .replace(/\s+/g, " ")
    .trim();

  if (!source) return "Summary unavailable for this article.";

  const rawSentences = splitIntoSentences(source)
    .map(normalizeSentence)
    .filter(isFullSentence);

  const picked = [];
  for (let i = 0; i < rawSentences.length && picked.length < 3; i++) {
    const s = rawSentences[i];
    if (!isNearDuplicateSentence(s, picked)) picked.push(s);
  }

  if (picked.length === 0) {
    const fallback = normalizeSentence(source.split(/\s+/).slice(0, 25).join(" "));
    if (isFullSentence(fallback)) picked.push(fallback);
  }

  return picked.length ? picked.join(" ") : "Summary unavailable for this article.";
}

function isFullSentence(sentence) {
  const s = cleanArticleText(sentence);
  const wc = s.split(/\s+/).filter(Boolean).length;
  if (wc < 8 || wc > 45) return false;
  if (!/[.!?]$/.test(s)) return false;
  if (/back button|home page|search for something on our site|click here|read more/i.test(s)) return false;

  const hasVerb =
    /\b(is|are|was|were|be|been|being|has|have|had|does|do|did|will|would|can|could|should|may|might|said|says|reported|announced|discussed|revealed|explained|described|showed|shows)\b/i.test(s) ||
    /\b\w+(ed|ing)\b/i.test(s);

  return hasVerb;
}

function normalizeSentence(sentence) {
  let s = cleanArticleText(sentence)
    .replace(/\s+([,.;:!?])/g, "$1")
    .replace(/\s{2,}/g, " ")
    .trim();

  if (!s) return "";
  s = s.charAt(0).toUpperCase() + s.slice(1);
  if (!/[.!?]$/.test(s)) s += ".";
  return s;
}

