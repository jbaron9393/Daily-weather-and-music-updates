function sendMorningNewsAndWeather() {
  const RECIPIENT = "james.baron@cuanschutz.edu";
  const LAT = 39.7093;
  const LON = -104.8146;
  const TZ = "America/Denver";

  const headers = {
    "User-Agent": "MorningNewsWeatherEmail/1.0 (james.baron@cuanschutz.edu)",
    "Accept": "application/xml, text/xml, application/rss+xml, application/json, text/html"
  };

  const weather = getWeatherSummary(LAT, LON, headers);
  const concerts = getDenverConcerts(headers, TZ);

  const topCandidates = getSectionArticles("https://abcnews.go.com/", "Top", headers, 12);
  const usCandidates = getSectionArticles("https://abcnews.go.com/us", "U.S.", headers, 20);
  const internationalCandidates = getSectionArticles("https://abcnews.go.com/international", "International", headers, 20);
  const politicsCandidates = getSectionArticles("https://abcnews.go.com/politics", "Politics", headers, 20);
  const businessCandidates = getSectionArticles("https://abcnews.go.com/business", "Business", headers, 20);
  const lifestyleCandidates = getSectionArticles("https://abcnews.go.com/lifestyle", "Lifestyle", headers, 20);

  const chosen = [];
  const seen = new Set();

  takeFromPool(chosen, seen, topCandidates, 1);
  takeFromPool(chosen, seen, usCandidates, 2);
  takeFromPool(chosen, seen, internationalCandidates, 2);

  // Fill remaining 5 from politics, business, lifestyle in round-robin
  fillRoundRobin(chosen, seen, [politicsCandidates, businessCandidates, lifestyleCandidates], 10);

  // If still short, use leftovers from all category pools
  fillRoundRobin(
    chosen,
    seen,
    [usCandidates, internationalCandidates, politicsCandidates, businessCandidates, lifestyleCandidates, topCandidates],
    10
  );

  const enrichedItems = enrichArticles(chosen, headers, 10);

  if (enrichedItems.length < 10) {
    Logger.log(`Only found ${enrichedItems.length} valid articles today after filtering.`);
  }

  const today = Utilities.formatDate(new Date(), TZ, "MMMM d, yyyy");
  const subject = today;

  const { htmlBody, plainBody, inlineImages } = buildEmail(weather, enrichedItems, concerts, today);

  MailApp.sendEmail({
    to: RECIPIENT,
    subject,
    body: plainBody,
    htmlBody,
    inlineImages,
    name: "🌞Morning Update🌞"
  });
}

